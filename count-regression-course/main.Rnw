library(knitr)
opts_chunk$set(
  comment    = "#>",
  prompt     = FALSE,
  tidy       = FALSE,
  size       = "footnotesize",
  fig.align  = "center",
  fig.pos    = "H",
  out.width  = "0.85\\textwidth",
  fig.width  = 7,
  fig.height = 4.2,
  dev        = "pdf",
  cache      = FALSE,
  fig.path   = "figure/",
  warning    = FALSE,
  message    = FALSE,
  background = "#F6F7F9"
)
options(width = 90, digits = 4, scipen = 3, show.signif.stars = TRUE)
set.seed(2024)

## Hard-wrap any output line that would run past the right margin (mostly the
## long warning messages that lme4 and glmmTMB emit).
wrap_lines <- function(x, n = 94) {
  ls <- unlist(strsplit(x, "\n", fixed = TRUE))
  ls <- unlist(lapply(ls, function(l) {
    if (nchar(l) <= n) return(l)
    strwrap(l, width = n, exdent = 5)
  }))
  paste(ls, collapse = "\n")
}
for (h in c("output", "warning", "message")) local({
  hh <- knit_hooks$get(h)
  knit_hooks$set(setNames(list(function(x, options) hh(wrap_lines(x), options)), h))
})

## A consistent look for base-R plots used throughout the book
PAL <- c(primary = "#114A66", accent = "#C05621", green = "#1F6E4A",
         red = "#9D2D2D", grey = "#8A97A0", amber = "#96660A",
         purple = "#5B4B8A", teal = "#0F7B7B")
par_book <- function(...) {
  par(mar = c(4.2, 4.2, 2.4, 1.2), mgp = c(2.5, 0.7, 0), tcl = -0.3,
      cex.main = 1.0, cex.lab = 0.95, cex.axis = 0.85,
      col.axis = "#1C2630", col.lab = "#1C2630", col.main = "#114A66",
      font.main = 1, bty = "l", ...)
}
grid_book <- function() grid(col = "#E3E8EC", lty = 1, lwd = 0.6)
@

