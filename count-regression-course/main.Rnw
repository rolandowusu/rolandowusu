\newtcolorbox{plainenglish}[1][In plain English]{
  breakable, enhanced, colback=primarylt, colframe=primary,
  boxrule=0pt, leftrule=3pt, arc=1pt, left=8pt, right=8pt, top=6pt, bottom=6pt,
  fonttitle=\sffamily\bfseries\small, coltitle=primary,
  attach boxed title to top left={xshift=6pt,yshift=-2pt},
  boxed title style={colback=primarylt,boxrule=0pt,arc=0pt,left=2pt,right=2pt,top=1pt,bottom=1pt},
  title={#1}, top=14pt}

\newtcolorbox{keyidea}[1][Key idea]{
  breakable, enhanced, colback=greenlt, colframe=greenbox,
  boxrule=0pt, leftrule=3pt, arc=1pt, left=8pt, right=8pt, top=6pt, bottom=6pt,
  fonttitle=\sffamily\bfseries\small, coltitle=greenbox,
  attach boxed title to top left={xshift=6pt,yshift=-2pt},
  boxed title style={colback=greenlt,boxrule=0pt,arc=0pt,left=2pt,right=2pt,top=1pt,bottom=1pt},
  title={#1}, top=14pt}

\newtcolorbox{warningbox}[1][Watch out]{
  breakable, enhanced, colback=redlt, colframe=redbox,
  boxrule=0pt, leftrule=3pt, arc=1pt, left=8pt, right=8pt, top=6pt, bottom=6pt,
  fonttitle=\sffamily\bfseries\small, coltitle=redbox,
  attach boxed title to top left={xshift=6pt,yshift=-2pt},
  boxed title style={colback=redlt,boxrule=0pt,arc=0pt,left=2pt,right=2pt,top=1pt,bottom=1pt},
  title={#1}, top=14pt}

\newtcolorbox{rulebox}[1][Rule of thumb]{
  breakable, enhanced, colback=amberlt, colframe=amber,
  boxrule=0pt, leftrule=3pt, arc=1pt, left=8pt, right=8pt, top=6pt, bottom=6pt,
  fonttitle=\sffamily\bfseries\small, coltitle=amber,
  attach boxed title to top left={xshift=6pt,yshift=-2pt},
  boxed title style={colback=amberlt,boxrule=0pt,arc=0pt,left=2pt,right=2pt,top=1pt,bottom=1pt},
  title={#1}, top=14pt}

